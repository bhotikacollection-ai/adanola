# MongoDB (Atlas recommended for Vercel)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/adanola?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary — product photography storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=adanola

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Client (Vite) — copy to client/.env
VITE_API_URL=http://localhost:5000/api
